{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hvitiswift-afk/nextjs-boilerplate/schemas/revenue/fardarter-drive-authority-v6.schema.json",
  "title": "Fardarter Drive Authority v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "driveId", "experimentId", "authorityVersion", "authorizedBy", "authorizedAt", "supersedesForFutureActions", "historicalReceiptsRemainValid", "grants", "guardrails", "revoked", "nextControlledAction"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "receiptId": { "const": "FARDARTER-DRIVE-AUTHORITY-V6-2026-07-29" },
    "driveId": { "const": "FARDARTER-DRIVE-V6" },
    "experimentId": { "const": "JP-REV-001" },
    "authorityVersion": { "const": "6.0.0" },
    "authorizedBy": { "const": "JP" },
    "authorizedAt": { "type": "string", "format": "date-time" },
    "supersedesForFutureActions": { "const": "receipts/revenue/FARDARTER-DRIVE-AUTHORITY-V5.json" },
    "historicalReceiptsRemainValid": { "const": true },
    "grants": {
      "type": "array",
      "minItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grantId", "state", "automated", "scope", "evidenceRequired"],
        "properties": {
          "grantId": { "type": "string", "minLength": 3 },
          "state": { "enum": ["AUTHORIZED_ACTIVE", "AUTHORIZED_CONDITIONAL", "HUMAN_APPROVAL_REQUIRED", "COUNSEL_REVIEW_REQUIRED", "EXTERNAL_PROVIDER_ONLY"] },
          "automated": { "type": "boolean" },
          "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "evidenceRequired": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacityEqualsDemand", "capacityEqualsCustomerCount", "capacityEqualsOrders", "capacityEqualsRevenue", "above100CapacityProhibited", "overrideActivatesWithoutReceipt", "overrideMayExceedTotalCapacity", "fitApprovalCreatesOrder", "fitApprovalCreatesContract", "draftCreatesPaymentObligation", "googleDriveFileCreatesSignature", "automaticPaidWorkStart", "templateIsIndemnityProof", "sensitiveDataAllowedInPublicRepo"],
      "properties": {
        "capacityEqualsDemand": { "const": false },
        "capacityEqualsCustomerCount": { "const": false },
        "capacityEqualsOrders": { "const": false },
        "capacityEqualsRevenue": { "const": false },
        "above100CapacityProhibited": { "const": false },
        "overrideActivatesWithoutReceipt": { "const": false },
        "overrideMayExceedTotalCapacity": { "const": false },
        "fitApprovalCreatesOrder": { "const": false },
        "fitApprovalCreatesContract": { "const": false },
        "draftCreatesPaymentObligation": { "const": false },
        "googleDriveFileCreatesSignature": { "const": false },
        "automaticPaidWorkStart": { "const": false },
        "templateIsIndemnityProof": { "const": false },
        "sensitiveDataAllowedInPublicRepo": { "const": false }
      }
    },
    "revoked": { "const": false },
    "nextControlledAction": { "type": "string", "minLength": 40 }
  }
}
