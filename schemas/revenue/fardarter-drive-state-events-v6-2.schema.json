{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/hvitiswift-afk/nextjs-boilerplate/schemas/revenue/fardarter-drive-state-events-v6-2.schema.json",
  "title":"Fardarter Drive State Event Chain v6.2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","chainId","driveId","controllerVersion","digestAlgorithm","canonicalization","appendOnly","headSequence","headDigest","eventCount","canonicalBusinessEventCount","events","currentCanonicalCounts","financialEvidence","capacityEvidence","nextControlledAction"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "chainId":{"const":"FARDARTER-DRIVE-STATE-EVENTS-V6-2"},
    "driveId":{"const":"FARDARTER-DRIVE-V6"},
    "controllerVersion":{"const":"6.2.0"},
    "digestAlgorithm":{"const":"SHA-256"},
    "canonicalization":{"const":"JSON_SORTED_KEYS_UTF8"},
    "appendOnly":{"const":true},
    "headSequence":{"type":"integer","minimum":0},
    "headDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "eventCount":{"type":"integer","minimum":1},
    "canonicalBusinessEventCount":{"type":"integer","minimum":0},
    "events":{"type":"array","minItems":1,"items":{"$ref":"./fardarter-drive-state-event-v6-2.schema.json"}},
    "currentCanonicalCounts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
    "financialEvidence":{"type":"object"},
    "capacityEvidence":{"type":"object"},
    "nextControlledAction":{"type":"string","minLength":40}
  }
}
