{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hvitiswift-afk/nextjs-boilerplate/schemas/revenue/revenue-experiment.schema.json",
  "title": "JP Revenue Experiment v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "experimentId", "status", "offer", "audience", "proofPackage", "authorityReceiptPath", "channel", "metrics", "money", "claims", "authority", "fundingUrls", "nextControlledAction"],
  "properties": {
    "schemaVersion": { "const": "1.3.0" },
    "experimentId": { "const": "JP-REV-001" },
    "status": { "const": "PUBLISHED" },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "priceUsd", "quantityTarget", "firstMilestoneUsd", "grossTargetUsd", "capacity", "maxConcurrentDeliveries", "deliveryWindowBusinessDays", "clarificationWindowDays", "scopeLimits", "deliverables", "exclusions"],
      "properties": {
        "name": { "const": "GitHub Control Tower Audit" },
        "type": { "const": "paid_service" },
        "priceUsd": { "const": 100 },
        "quantityTarget": { "const": 1000 },
        "firstMilestoneUsd": { "const": 1000 },
        "grossTargetUsd": { "const": 100000 },
        "capacity": { "const": 1000 },
        "maxConcurrentDeliveries": { "const": 100 },
        "deliveryWindowBusinessDays": { "type": "integer", "minimum": 1 },
        "clarificationWindowDays": { "type": "integer", "minimum": 0 },
        "scopeLimits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositories", "maxOpenPullRequests", "maxOpenIssues", "clarificationRounds"],
          "properties": {
            "repositories": { "const": 1 },
            "maxOpenPullRequests": { "type": "integer", "minimum": 1, "maximum": 25 },
            "maxOpenIssues": { "type": "integer", "minimum": 1, "maximum": 50 },
            "clarificationRounds": { "type": "integer", "minimum": 0 }
          }
        },
        "deliverables": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "exclusions": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } }
      }
    },
    "audience": { "type": "string", "minLength": 10 },
    "proofPackage": {
      "type": "array",
      "minItems": 15,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "not": { "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)[.][.](?:/|$))" } }
    },
    "authorityReceiptPath": { "const": "receipts/revenue/FARDARTER-DRIVE-AUTHORITY-V6.json" },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "inboundRequestPath", "publicationAuthorized", "outreachAuthorized"],
      "properties": {
        "name": { "const": "GitHub inbound issue #133" },
        "inboundRequestPath": { "const": ".github/ISSUE_TEMPLATE/control-tower-audit-request.yml" },
        "publicationAuthorized": { "const": true },
        "outreachAuthorized": { "const": false }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["views", "qualifiedConversations", "offersSent", "orders", "deliveriesAccepted"],
      "properties": {
        "views": { "type": "integer", "minimum": 0 },
        "qualifiedConversations": { "type": "integer", "minimum": 0 },
        "offersSent": { "type": "integer", "minimum": 0 },
        "orders": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "deliveriesAccepted": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grossRevenueUsd", "feesUsd", "refundsUsd", "netCashUsd", "settlementState"],
      "properties": {
        "grossRevenueUsd": { "type": "number", "minimum": 0 },
        "feesUsd": { "type": "number", "minimum": 0 },
        "refundsUsd": { "type": "number", "minimum": 0 },
        "netCashUsd": { "type": "number" },
        "settlementState": { "enum": ["UNKNOWN", "PAID_PENDING", "PAID_SETTLED", "REFUNDED", "DISPUTED"] }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earningsGuaranteed", "taxDeductible", "repaymentPromised", "equityOffered", "legalStatusClaimed"],
      "properties": {
        "earningsGuaranteed": { "const": false },
        "taxDeductible": { "const": false },
        "repaymentPromised": { "const": false },
        "equityOffered": { "const": false },
        "legalStatusClaimed": { "const": false }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offerPreparation", "publication", "outreach", "contract", "paymentExecution", "delivery"],
      "properties": {
        "offerPreparation": { "const": "authorized" },
        "publication": { "const": "authorized" },
        "outreach": { "const": "not_authorized" },
        "contract": { "const": "not_authorized" },
        "paymentExecution": { "const": "external_provider_only" },
        "delivery": { "const": "not_authorized" }
      }
    },
    "fundingUrls": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
    "nextControlledAction": { "type": "string", "minLength": 40 }
  }
}
