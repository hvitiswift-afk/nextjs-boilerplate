{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hvitiswift-afk/nextjs-boilerplate/schemas/revenue/fardarter-drive-state-event-v6-2.schema.json",
  "title": "Fardarter Drive State Event v6.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","eventId","sequence","eventType","idempotencyKey","entityType","entityId","fromState","toState","classification","sourceEvidence","authorityGate","capacityEffect","financialEffect","previousEventDigest","eventDigest","occurredAt","recordedAt","canonical","publicSafe","sensitiveDataPresent"],
  "properties": {
    "schemaVersion": {"const":"1.0.0"},
    "eventId": {"type":"string","minLength":8},
    "sequence": {"type":"integer","minimum":0},
    "eventType": {"enum":["GENESIS","STATE_TRANSITION","RECOVERY","REVERSAL"]},
    "idempotencyKey": {"type":"string","minLength":8},
    "entityType": {"enum":["SYSTEM","GITHUB_ISSUE","AUDIT_ENGAGEMENT"]},
    "entityId": {"type":"string","minLength":1},
    "fromState": {"type":["string","null"],"enum":[null,"REQUESTED","FIT_APPROVED_FOR_SCOPE_DRAFT","SCOPE_DRAFTED","HUMAN_ACCEPTED","PAID_PENDING","PAID_SETTLED","WORK_START_APPROVED","ACTIVE","DELIVERED","ACCEPTED","CANCELLED","REFUNDED","DISPUTED"]},
    "toState": {"type":["string","null"],"enum":[null,"REQUESTED","FIT_APPROVED_FOR_SCOPE_DRAFT","SCOPE_DRAFTED","HUMAN_ACCEPTED","PAID_PENDING","PAID_SETTLED","WORK_START_APPROVED","ACTIVE","DELIVERED","ACCEPTED","CANCELLED","REFUNDED","DISPUTED"]},
    "classification": {"enum":["CANONICAL_GENESIS","CANONICAL_BUSINESS_EVENT","CANONICAL_RECOVERY_EVENT"]},
    "sourceEvidence": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":3}},
    "authorityGate": {"type":"string","minLength":3},
    "capacityEffect": {
      "type":"object","additionalProperties":false,"required":["usesActiveCapacity","activeDelta"],
      "properties":{"usesActiveCapacity":{"type":"boolean"},"activeDelta":{"type":"integer","minimum":-1,"maximum":1}}
    },
    "financialEffect": {
      "type":"object","additionalProperties":false,"required":["createsOrder","grossRevenueDeltaUsd","settledCashDeltaUsd","settlementState"],
      "properties":{"createsOrder":{"type":"boolean"},"grossRevenueDeltaUsd":{"type":"number"},"settledCashDeltaUsd":{"type":"number"},"settlementState":{"enum":["UNKNOWN","PAID_PENDING","PAID_SETTLED","REFUNDED","DISPUTED"]}}
    },
    "previousEventDigest": {"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "eventDigest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "occurredAt": {"type":"string","format":"date-time"},
    "recordedAt": {"type":"string","format":"date-time"},
    "canonical": {"const":true},
    "publicSafe": {"const":true},
    "sensitiveDataPresent": {"const":false}
  }
}
