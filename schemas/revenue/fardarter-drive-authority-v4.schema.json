{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hvitiswift-afk/nextjs-boilerplate/schemas/revenue/fardarter-drive-authority-v4.schema.json",
  "title": "Fardarter Drive Authority v4 Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "driveId",
    "authorityVersion",
    "authorizedBy",
    "authorizedAt",
    "supersedesForFutureActions",
    "historicalReceiptsRemainValid",
    "grants",
    "guardrails",
    "revoked",
    "nextControlledAction"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "receiptId": { "const": "FARDARTER-DRIVE-AUTHORITY-V4-2026-07-29" },
    "driveId": { "const": "FARDARTER-DRIVE-V4" },
    "authorityVersion": { "const": "4.0.0" },
    "authorizedBy": { "const": "JP" },
    "authorizedAt": { "type": "string", "format": "date-time" },
    "supersedesForFutureActions": { "const": "receipts/revenue/JP-REV-001-AUTHORITY.json" },
    "historicalReceiptsRemainValid": { "const": true },
    "grants": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grantId", "state", "automated", "scope", "evidenceRequired"],
        "properties": {
          "grantId": {
            "enum": [
              "SCALE_HORIZON_PUBLICATION",
              "REPOSITORY_IMPLEMENTATION_AND_RECEIPTS",
              "DOCUMENT_DRAFT_AUTOMATION",
              "RELEVANT_EXACT_OUTREACH",
              "GITHUB_INBOUND_AUTOMATION",
              "VERIFIED_MERGE",
              "FIXED_SITE_DEPLOYMENT",
              "CONTRACT_ACCEPTANCE",
              "INDEMNITY_AND_LIABILITY_TERMS",
              "PAYMENT_EXECUTION",
              "DELIVERY_START",
              "REFUND_DISPUTE_OR_ADMISSION",
              "BANK_BILLING_DOMAIN_CREDENTIAL_OR_DESTRUCTIVE_ACTION"
            ]
          },
          "state": {
            "enum": [
              "AUTHORIZED_ACTIVE",
              "AUTHORIZED_CONDITIONAL",
              "HUMAN_APPROVAL_REQUIRED",
              "COUNSEL_REVIEW_REQUIRED",
              "EXTERNAL_PROVIDER_ONLY",
              "NOT_AUTHORIZED"
            ]
          },
          "automated": { "type": "boolean" },
          "scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 12 }
          },
          "evidenceRequired": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 8 }
          }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizonEqualsAchievedRevenue",
        "horizonEqualsValuation",
        "publicFitCheckCreatesOrder",
        "draftCreatesContract",
        "invoiceDraftCreatesPaymentObligation",
        "automatedAcknowledgementAcceptsScope",
        "githubEvidenceProvesSettlement",
        "unverifiedScreenshotProvesPayment",
        "templateIsIndemnityProof",
        "willfulMisconductOrBadFaithAutomaticallyExcused",
        "sensitiveDataAllowedInPublicRepo"
      ],
      "properties": {
        "horizonEqualsAchievedRevenue": { "const": false },
        "horizonEqualsValuation": { "const": false },
        "publicFitCheckCreatesOrder": { "const": false },
        "draftCreatesContract": { "const": false },
        "invoiceDraftCreatesPaymentObligation": { "const": false },
        "automatedAcknowledgementAcceptsScope": { "const": false },
        "githubEvidenceProvesSettlement": { "const": false },
        "unverifiedScreenshotProvesPayment": { "const": false },
        "templateIsIndemnityProof": { "const": false },
        "willfulMisconductOrBadFaithAutomaticallyExcused": { "const": false },
        "sensitiveDataAllowedInPublicRepo": { "const": false }
      }
    },
    "revoked": { "const": false },
    "nextControlledAction": { "type": "string", "minLength": 40 }
  }
}
